exclude:
  code:
    - app/controllers/case_workers/claims_controller.rb
    - app/controllers/establishments_controller.rb
    - app/controllers/external_users/claims_controller.rb
    - app/controllers/offences_controller.rb
    - app/controllers/feedback_controller.rb
    - app/interfaces/api/v2/mi/agfs_scheme_ten_claims.rb
ignore:
  SNYK-JS-PICOMATCH-21248802:
    - 'sass > @parcel/watcher > picomatch':
        reason: >-
          Non-exploitable. picomatch is a build-time dev dependency via
          sass > @parcel/watcher (watch mode only, not used in the CI build);
          no attacker-controlled glob patterns reach it and it is not in the
          production runtime.
        created: 2026-11-03T00:00:00.000Z
        expires: 2027-11-03T00:00:00.000Z