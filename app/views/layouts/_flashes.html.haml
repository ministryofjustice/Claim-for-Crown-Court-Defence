- flash.each do |key, value|
  - unless %w{hidden ga timedout}.include? key
    - if key == 'alert' && value.is_a?(Hash)
      - message = value.with_indifferent_access
      = moj_alert(type: :error, heading: message[:title], body: (tag.p(message[:text], class: 'govuk-body') if message[:text].present?), dismiss_text: nil)
    - else
      = govuk_notification_banner(title_text: key.capitalize, success: key == 'notice', classes: "auto-dismiss-banner") do |nb|
        - nb.with_heading(text: value)
